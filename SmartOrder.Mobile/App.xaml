<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SmartOrder.Mobile"
             x:Class="SmartOrder.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="BrandNavy">#12344D</Color>
            <Color x:Key="BrandBlue">#1B587C</Color>
            <Color x:Key="BrandGreen">#0B6E4F</Color>
            <Color x:Key="PageBackground">#F4F7FB</Color>
            <Color x:Key="SectionBackground">#EAF2FB</Color>
            <Color x:Key="SoftGreen">#E8F5EF</Color>
            <Color x:Key="MutedText">#627D98</Color>

            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource PageBackground}" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource BrandNavy}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="{StaticResource BrandNavy}" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="{StaticResource BrandNavy}" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>

            <Style TargetType="DatePicker">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="{StaticResource BrandNavy}" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>

            <Style TargetType="TimePicker">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="{StaticResource BrandNavy}" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource BrandGreen}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="MinimumHeightRequest" Value="48" />
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource SectionBackground}" />
                <Setter Property="TextColor" Value="{StaticResource BrandBlue}" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
