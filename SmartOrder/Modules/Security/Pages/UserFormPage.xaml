<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartOrder.Modules.Security.Pages.UserFormPage"
             Title="Usuario"
             BackgroundColor="#F4F7FB">

    <ScrollView>
        <VerticalStackLayout Padding="18,14,18,18"
                             Spacing="0">
            <Frame BackgroundColor="#12344D"
                   BorderColor="#12344D"
                   CornerRadius="18"
                   Padding="14"
                   HasShadow="True"
                   Margin="0,0,0,12">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="PageTitleLabel"
                           Text="Nuevo usuario"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Define identidad, rol y estado del usuario"
                           FontSize="13"
                           TextColor="#D9E2EC" />
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="White"
                   BorderColor="#D9E2EC"
                   CornerRadius="18"
                   Padding="16"
                   HasShadow="True">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Datos del usuario"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#102A43" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nombre completo"
                               FontSize="13"
                               TextColor="#627D98" />
                        <Entry x:Name="FullNameEntry"
                               Placeholder="Nombre completo" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Correo electrónico"
                               FontSize="13"
                               TextColor="#627D98" />
                        <Entry x:Name="EmailEntry"
                               Placeholder="correo@dominio.com"
                               Keyboard="Email" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Rol"
                               FontSize="13"
                               TextColor="#627D98" />
                        <Picker x:Name="RolePicker"
                                Title="Selecciona un rol"
                                Style="{StaticResource PickerControlStyle}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label x:Name="PasswordLabel"
                               Text="Contraseña"
                               FontSize="13"
                               TextColor="#627D98" />
                        <Entry x:Name="PasswordEntry"
                               Placeholder="Captura la contraseña"
                               IsPassword="True" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">
                        <Switch x:Name="IsActiveSwitch"
                                IsToggled="True"
                                VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="2">
                            <Label Text="Usuario activo"
                                   FontAttributes="Bold"
                                   TextColor="#102A43" />
                            <Label Text="Desactiva el usuario si no debe poder iniciar sesión"
                                   FontSize="12"
                                   TextColor="#627D98" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12"
                          Margin="0,8,0,0">
                        <HorizontalStackLayout Spacing="12">
                            <Button Text="Guardar"
                                    Clicked="OnSaveClicked"
                                    BackgroundColor="#0B6E4F"
                                    TextColor="White"
                                    CornerRadius="14"
                                    HeightRequest="50"
                                    FontAttributes="Bold"
                                    HorizontalOptions="FillAndExpand" />

                            <Button x:Name="DeactivateButton"
                                    Text="Desactivar"
                                    Clicked="OnDeactivateClicked"
                                    BackgroundColor="#B42318"
                                    TextColor="White"
                                    CornerRadius="14"
                                    HeightRequest="50"
                                    FontAttributes="Bold"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="False" />
                        </HorizontalStackLayout>

                        <Button Grid.Column="1"
                                Text="Regresar"
                                Clicked="OnBackClicked"
                                BackgroundColor="#D9E2EC"
                                TextColor="#102A43"
                                CornerRadius="14"
                                HeightRequest="50"
                                FontAttributes="Bold"
                                Padding="18,0" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
