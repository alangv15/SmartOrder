<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartOrder.Modules.Security.Pages.RoleFormPage"
             Title="Rol"
             BackgroundColor="#F4F7FB">

    <ScrollView>
        <VerticalStackLayout Padding="18,14,18,18"
                             Spacing="0">
            <Frame BackgroundColor="#12344D"
                   BorderColor="#12344D"
                   CornerRadius="18"
                   Padding="14"
                   HasShadow="True"
                   Margin="0,0,0,12">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="PageTitleLabel"
                           Text="Nuevo rol"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Configura la identidad tecnica y funcional del rol"
                           FontSize="13"
                           TextColor="#D9E2EC" />
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="White"
                   BorderColor="#D9E2EC"
                   CornerRadius="18"
                   Padding="16"
                   HasShadow="True">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Datos del rol"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#102A43" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nombre"
                               FontSize="13"
                               TextColor="#627D98" />
                        <Entry x:Name="NameEntry"
                               Placeholder="Nombre visible del rol" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Codigo"
                               FontSize="13"
                               TextColor="#627D98" />
                        <Entry x:Name="CodeEntry"
                               Placeholder="ADMIN, MANAGER, CASHIER..." />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Descripcion"
                               FontSize="13"
                               TextColor="#627D98" />
                        <Editor x:Name="DescriptionEditor"
                                Placeholder="Describe el alcance general del rol"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="110" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">
                        <Switch x:Name="IsActiveSwitch"
                                IsToggled="True"
                                VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="2">
                            <Label Text="Rol activo"
                                   FontAttributes="Bold"
                                   TextColor="#102A43" />
                            <Label Text="Desactiva el rol si ya no debe poder asignarse a nuevos usuarios"
                                   FontSize="12"
                                   TextColor="#627D98" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12"
                          Margin="0,8,0,0">
                        <HorizontalStackLayout Spacing="12">
                            <Button Text="Guardar"
                                    Clicked="OnSaveClicked"
                                    BackgroundColor="#6B2F54"
                                    TextColor="White"
                                    CornerRadius="14"
                                    HeightRequest="50"
                                    FontAttributes="Bold"
                                    HorizontalOptions="FillAndExpand" />

                            <Button x:Name="DeactivateButton"
                                    Text="Desactivar"
                                    Clicked="OnDeactivateClicked"
                                    BackgroundColor="#B42318"
                                    TextColor="White"
                                    CornerRadius="14"
                                    HeightRequest="50"
                                    FontAttributes="Bold"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="False" />
                        </HorizontalStackLayout>

                        <Button Grid.Column="1"
                                Text="Regresar"
                                Clicked="OnBackClicked"
                                BackgroundColor="#D9E2EC"
                                TextColor="#102A43"
                                CornerRadius="14"
                                HeightRequest="50"
                                FontAttributes="Bold"
                                Padding="18,0" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
