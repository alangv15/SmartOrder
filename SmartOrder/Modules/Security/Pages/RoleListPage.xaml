<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartOrder.Modules.Security.Pages.RoleListPage"
             Title="Roles"
             BackgroundColor="#F4F7FB">

    <Grid RowDefinitions="Auto,*"
          Padding="18,14,18,18"
          RowSpacing="0">

        <Frame Grid.Row="0"
               BackgroundColor="#12344D"
               BorderColor="#12344D"
               CornerRadius="18"
               Padding="14"
               HasShadow="True"
               Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Administracion de roles"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Crea y ajusta los perfiles base de acceso del sistema"
                           FontSize="13"
                           TextColor="#D9E2EC" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Nuevo rol"
                        Clicked="OnAddClicked"
                        BackgroundColor="#6B2F54"
                        TextColor="White"
                        CornerRadius="14"
                        HeightRequest="48"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />
            </Grid>
        </Frame>

        <CollectionView x:Name="RoleList"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnItemSelected">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40"
                                     Spacing="8"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Label Text="No hay roles registrados"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#102A43"
                           HorizontalOptions="Center" />
                    <Label Text="Agrega un rol para comenzar a organizar el acceso por perfil."
                           FontSize="14"
                           TextColor="#627D98"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="White"
                           BorderColor="#D9E2EC"
                           CornerRadius="18"
                           Padding="16"
                           HasShadow="True"
                           Margin="0,0,0,12">
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Row="0"
                                                 Grid.Column="0"
                                                 Spacing="3">
                                <Label Text="{Binding Name}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#102A43" />
                                <Label Text="{Binding Code, StringFormat='Codigo: {0}'}"
                                       FontSize="13"
                                       TextColor="#486581" />
                            </VerticalStackLayout>

                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    Padding="10,6"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding IsActive, Converter={StaticResource BoolToColorConverter}}"
                                    StrokeShape="RoundRectangle 14">
                                <Label Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>

                            <Label Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding Description}"
                                   FontSize="13"
                                   TextColor="#627D98"
                                   Margin="0,12,0,0" />

                            <Label Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding UserCount, StringFormat='Usuarios asignados: {0}'}"
                                   FontSize="12"
                                   TextColor="#627D98"
                                   Margin="0,12,0,0" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
