<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartOrder.Modules.Configuration.Pages.RecipeListPage"
             Title="Recetas"
             BackgroundColor="#F4F7FB">
    <Grid RowDefinitions="Auto,*" Padding="18,14,18,18">
        <Frame Grid.Row="0" BackgroundColor="#12344D" BorderColor="#12344D" CornerRadius="18" Padding="14" HasShadow="True" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="HeaderLabel" Text="Recetas de producto" FontSize="22" FontAttributes="Bold" TextColor="White" />
                    <Label x:Name="SubtitleLabel" Text="Bases e conceptos adicionales" FontSize="13" TextColor="#D9E2EC" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="10">
                    <Button Text="Actualizar" Clicked="OnRefreshClicked" BackgroundColor="#D9E2EC" TextColor="#102A43" HeightRequest="48" />
                    <Button x:Name="AddButton" Text="Nueva receta" Clicked="OnAddClicked" BackgroundColor="#0B6E4F" TextColor="White" CornerRadius="14" HeightRequest="48" FontAttributes="Bold" />
                </HorizontalStackLayout>
            </Grid>
        </Frame>
        <CollectionView x:Name="RecipeList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnItemSelected">
            <CollectionView.EmptyView>
                <Label Text="No hay recetas registradas" Padding="40" FontSize="18" FontAttributes="Bold" TextColor="#102A43" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="White" BorderColor="#D9E2EC" CornerRadius="18" Padding="16" HasShadow="True" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding ProductName}" FontSize="17" FontAttributes="Bold" TextColor="#102A43" />
                                <Label Text="{Binding Summary}" FontSize="13" TextColor="#627D98" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding RecipeCostSummary}" FontSize="18" FontAttributes="Bold" TextColor="#0B6E4F" VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
