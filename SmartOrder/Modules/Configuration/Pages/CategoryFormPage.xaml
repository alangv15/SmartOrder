<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartOrder.Modules.Configuration.Pages.CategoryFormPage"
             Title="Categoria"
             BackgroundColor="#F4F7FB">

    <ScrollView>
        <VerticalStackLayout Padding="18,14,18,18" Spacing="0">
            <Frame BackgroundColor="#12344D"
                   BorderColor="#12344D"
                   CornerRadius="18"
                   Padding="14"
                   HasShadow="True"
                   Margin="0,0,0,12">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="PageTitleLabel"
                           Text="Nueva categoria"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Define nombre, orden y disponibilidad para mostrador"
                           FontSize="13"
                           TextColor="#D9E2EC" />
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="White"
                   BorderColor="#D9E2EC"
                   CornerRadius="18"
                   Padding="16"
                   HasShadow="True">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Datos de la categoria"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#102A43" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Nombre" FontSize="13" TextColor="#627D98" />
                            <Entry x:Name="NameEntry" Placeholder="Nombre de la categoria" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Orden" FontSize="13" TextColor="#627D98" />
                            <Entry x:Name="DisplayOrderEntry"
                                   Placeholder="0"
                                   WidthRequest="120"
                                   Keyboard="Numeric" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Descripcion" FontSize="13" TextColor="#627D98" />
                        <Editor x:Name="DescriptionEditor"
                                Placeholder="Descripcion opcional"
                                AutoSize="TextChanges"
                                HeightRequest="90" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Switch x:Name="IsDirectSaleSwitch" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Disponible para mostrador" FontAttributes="Bold" TextColor="#102A43" />
                            <Label Text="Activa esta opcion si la categoria debe aparecer en la pantalla de ventas."
                                   FontSize="12"
                                   TextColor="#627D98" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Switch x:Name="IsActiveSwitch" IsToggled="True" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Categoria activa" FontAttributes="Bold" TextColor="#102A43" />
                            <Label Text="Desactiva la categoria si ya no debe estar disponible."
                                   FontSize="12"
                                   TextColor="#627D98" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,8,0,0">
                        <HorizontalStackLayout Spacing="12">
                            <Button Text="Guardar"
                                    Clicked="OnSaveClicked"
                                    BackgroundColor="#0B6E4F"
                                    TextColor="White"
                                    CornerRadius="14"
                                    HeightRequest="50"
                                    FontAttributes="Bold"
                                    HorizontalOptions="FillAndExpand" />

                            <Button x:Name="DeactivateButton"
                                    Text="Desactivar"
                                    Clicked="OnDeactivateClicked"
                                    BackgroundColor="#B42318"
                                    TextColor="White"
                                    CornerRadius="14"
                                    HeightRequest="50"
                                    FontAttributes="Bold"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="False" />
                        </HorizontalStackLayout>

                        <Button Grid.Column="1"
                                Text="Regresar"
                                Clicked="OnBackClicked"
                                BackgroundColor="#D9E2EC"
                                TextColor="#102A43"
                                CornerRadius="14"
                                HeightRequest="50"
                                FontAttributes="Bold"
                                Padding="18,0" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
