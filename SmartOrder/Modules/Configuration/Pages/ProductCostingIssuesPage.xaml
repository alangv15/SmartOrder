<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartOrder.Modules.Configuration.Pages.ProductCostingIssuesPage"
             Title="Productos sin costeo"
             BackgroundColor="#F4F7FB">
    <Grid RowDefinitions="Auto,*" Padding="18,14,18,18">
        <Frame Grid.Row="0" BackgroundColor="#12344D" BorderColor="#12344D" CornerRadius="18" Padding="14" HasShadow="True" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Productos sin costeo" FontSize="22" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Detecta productos sin precio o receta vigente" FontSize="13" TextColor="#D9E2EC" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Actualizar" Clicked="OnRefreshClicked" BackgroundColor="#0B6E4F" TextColor="White" CornerRadius="14" HeightRequest="48" FontAttributes="Bold" />
            </Grid>
        </Frame>
        <CollectionView x:Name="IssuesList" Grid.Row="1">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Costeo completo" FontSize="18" FontAttributes="Bold" TextColor="#0B6E4F" HorizontalTextAlignment="Center" />
                    <Label Text="Todos los productos activos tienen precio y receta vigente." FontSize="14" TextColor="#627D98" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="White" BorderColor="#F7D794" CornerRadius="18" Padding="16" HasShadow="True" Margin="0,0,0,12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding ProductName}" FontSize="17" FontAttributes="Bold" TextColor="#102A43" />
                            <Label Text="{Binding CategoryName}" FontSize="13" TextColor="#627D98" />
                            <Label Text="{Binding Issue}" FontSize="14" FontAttributes="Bold" TextColor="#B7791F" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
