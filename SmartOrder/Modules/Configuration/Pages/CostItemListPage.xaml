<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartOrder.Modules.Configuration.Pages.CostItemListPage"
             Title="Insumos y servicios"
             BackgroundColor="#F4F7FB">
    <Grid RowDefinitions="Auto,Auto,*" Padding="18,14,18,18">
        <Frame Grid.Row="0" BackgroundColor="#12344D" BorderColor="#12344D" CornerRadius="18" Padding="14" HasShadow="True" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Insumos y servicios" FontSize="22" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Gestiona conceptos, costo vigente e historial" FontSize="13" TextColor="#D9E2EC" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Nuevo concepto" Clicked="OnAddClicked" BackgroundColor="#0B6E4F" TextColor="White" CornerRadius="14" HeightRequest="48" FontAttributes="Bold" />
            </Grid>
        </Frame>

        <VerticalStackLayout Grid.Row="1" Spacing="6" Margin="0,0,0,12">
            <Label Text="Tipo de concepto" TextColor="#627D98" FontSize="13" />
            <Picker x:Name="TypeFilterPicker" HeightRequest="48" BackgroundColor="#EAF2FB" SelectedIndexChanged="OnTypeFilterChanged" />
        </VerticalStackLayout>
        <CollectionView x:Name="CostItemList" Grid.Row="2" SelectionMode="Single" SelectionChanged="OnItemSelected">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="No hay conceptos registrados" FontSize="18" FontAttributes="Bold" TextColor="#102A43" />
                    <Label Text="Agrega conceptos para poder construir recetas." FontSize="14" TextColor="#627D98" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="White" BorderColor="#D9E2EC" CornerRadius="18" Padding="16" HasShadow="True" Margin="0,0,0,12">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" TextColor="#102A43" />
                                <Label Text="{Binding Description}" FontSize="13" TextColor="#627D98" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" Padding="10,6" StrokeThickness="0" BackgroundColor="{Binding StatusColor}" StrokeShape="RoundRectangle 14">
                                <Label Text="{Binding StatusText}" FontSize="12" FontAttributes="Bold" TextColor="White" />
                            </Border>
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                                <Label Text="{Binding CurrentCostSummary}" FontSize="13" TextColor="#486581" />
                                <Label Grid.Column="1" Text="{Binding UnitCostSummary}" FontSize="15" FontAttributes="Bold" TextColor="#0B6E4F" />
                            </Grid>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
